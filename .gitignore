# Build leftovers: the compiler's files there hold the full path of the PC they were built on
# (C:\Users\<name>\...). build.cmd makes them again.
build/
# What build.cmd makes in the top folder (releases carry them: tools/package.ps1 -> dist/)
/Grimcold.exe
/libzstd.dll
/dist/
# crosscalc.net's item table and the old game data that tools/stats/make_stats.py reads: not ours to
# publish (ui/stats.json, built from them, is)
/tools/stats/*.json
# the screenshots' full-size originals (the README shows the JPEG copies)
/screenshots/*.png
# The translated name tables (parts, paints, maps, modes) are the game's own names and texts, gathered
# from the reader's install by tools/zh_*.mjs: the game holds their copyright, as with tools/stats/*.json
# above, so they stay out of the repository. Run the generator to make them again.
/ui/names.zh.json
/ui/paints.zh.json
/ui/maps.zh.json
/ui/modes.zh.json
# The generators' reports (working notes: they quote the game's names too)
/ui/names.zh.*.txt
/ui/paints.zh.txt
/ui/maps.zh.txt
/ui/modes.zh.txt

